SPRING_PROFILES_ACTIVE=prod
DB_NAME=poppy
DB_USERNAME=poppy
DB_PORT=5432
DB_PASSWORD=change-me
POPPY_AGENT_TOKEN=change-me
POPPY_ADMIN_USERNAME=change-me
POPPY_ADMIN_PASSWORD_HASH=change-me
POPPY_ADMIN_COOKIE_SECURE=true
POPPY_ADMIN_LOGIN_IP_MAX_ATTEMPTS=20
# 앞단에 리버스 프록시가 있을 때만 그 프록시의 IP/대역을 정규식으로 설정한다(예: 127\.0\.0\.1). 비워두면 X-Forwarded-For를 신뢰하지 않는다
TRUSTED_PROXIES=
# 관리자 웹이 API와 다른 origin에서 접근할 때만 콤마로 구분해 설정한다. 비어 있으면 모든 cross-origin 요청을 거부한다
ADMIN_ALLOWED_ORIGINS=
# CSRF 토큰을 담는 세션 쿠키 Secure, 운영 환경은 true
SESSION_COOKIE_SECURE=true
# CSRF 토큰을 담는 세션 쿠키 SameSite. 관리자 웹이 cross-site면 None으로 설정하고 SESSION_COOKIE_SECURE=true가 반드시 필요하다
SESSION_COOKIE_SAME_SITE=strict
